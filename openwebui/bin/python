#!/bin/bash -e
DIR=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && cd .. && pwd )
LIBS=$(echo ${DIR}/usr/local/lib)
LIBS=$LIBS:$(echo ${DIR}/usr/lib/*-linux-gnu*)
LD=$(echo ${DIR}/usr/lib/*-linux*/ld-*.so*)
echo "python ld: $LD"
echo "python libs: $LIBS"
exec $LD --library-path $LIBS ${DIR}/usr/local/bin/python3 "$@"
