export WEBUI_URL={{ .AppUrl }}
export ENABLE_PASSWORD_AUTH=false
export ENABLE_LOGIN_FORM=false
export ENABLE_OAUTH_SIGNUP=true
export OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
export OAUTH_CLIENT_ID={{ .OidcClientId }}
export OAUTH_CLIENT_SECRET={{ .OidcClientSecret }}
export OPENID_PROVIDER_URL={{ .AuthUrl }}/.well-known/openid-configuration
export OAUTH_PROVIDER_NAME=Authelia
export OAUTH_SCOPES="openid email profile groups"
export ENABLE_OAUTH_ROLE_MANAGEMENT=true
export OAUTH_ADMIN_ROLES=syncloud
export OAUTH_ROLES_CLAIM=groups
export OAUTH_CODE_CHALLENGE_METHOD=S256
export WEBUI_SECRET_KEY={{ .Secret }}
export DATA_DIR={{ .DataDir }}
